					width: 48px;
					height:43px;
					cursor:pointer;
				}
				#games_box .icon_sv{
					width: 39px;
					height: 32px;
					position: absolute;
					top:7px;
					right:8px;
					margin:0px;
				}
				#games_box.active .icon_sv{
					width: 39px;
					height: 32px;
					position: absolute;
				}

			#m_menu.active{
				display:block;

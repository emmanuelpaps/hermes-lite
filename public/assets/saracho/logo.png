			#emoij_box {
				display: none;
			}
			#quiz_box {
				display: none;
			}
			#news_box {
				display: none;
			}
			
			#service_box{
				display: block;
			}
			#service_box{
				float: right;
				position: relative;
    			width: 48px;
    			height:43px;
				cursor:pointer;
			}
			#service_box .icon_sv{
				width: 39px;
				height: 32px;
				position: absolute;
				top:7px;
				right:8px;
				margin:0px;
				background: url('https://1000marcas.net/color-wheel/images/ico_serv.svg') no-repeat center center;
			}
			#service_box.active .icon_sv{
				width: 39px;
				height: 32px;
				position: absolute;
				background: url('https://1000marcas.net/color-wheel/images/ico_serv_h.svg') no-repeat center center;
			}
			
			#games_box{

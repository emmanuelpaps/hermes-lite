#shiftnav-main .shiftnav-nav a{
	font-family:'Oswald',sans-serif !important;
}</style><style>#banner-wrapper {
            border-bottom: solid 1px #fff;
            color: #000;
            font-size: 13px;
            box-shadow: 0px 1px 5px rgba(0,0,0,0.3);
            height: 60px;
            background: -moz-linear-gradient(top, #F2F2F2, #E4E4E4);
            background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,#F2F2F2), color-stop(100%,#E4E4E4));
            background: -webkit-linear-gradient(top, #F2F2F2 0%,#E4E4E4 100%);
            background: -o-linear-gradient(top, #F2F2F2 0%,#E4E4E4 100%);
            background: -ms-linear-gradient(top, #F2F2F2 0%,#E4E4E4 100%);
            background: linear-gradient(to bottom, #F2F2F2 0%,#E4E4E4 100%);
            filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#F2F2F2', endColorstr='#E4E4E4',GradientType=0 );
        }
            #banner-wrapper .left {
                float: left;
                line-height: 16px;
            }
                #banner-wrapper .left .bannerclosebutton {
                    float: left;
                    width: 25px;
                    height: 60px;
                    text-align: center;
                    line-height: 60px;
                    color: #999;
                }
                #banner-wrapper .left .bannertext {
                    float: left;
                    height: 60px;
                    background: url(/img/testdrive-banner-logo.png) no-repeat 0px 7px;
                    padding-left: 5px;
                    line-height: 16px;
                    word-wrap: break-word;
                    width: 155px;
                    padding-top: 14px;
                    text-shadow: rgba(255,255,255,0.65) 0px 1px;
                    filter: Shadow(Color=#fff, Direction=90, Strength=1);
                }

            #banner-wrapper .right.normal a{
                color: #f8a304;
				font-weight: bold;
            }

            #banner-wrapper .right {
                float: right;
                height: 30px;
                line-height: 30px;
                font-size: 15px;
                text-align: center;
                padding-bottom: 15px;
                padding-top: 14px;
                padding-right: 13px;
                text-shadow: rgba(255,255,255,0.65) 0px 1px;
                filter: Shadow(Color=#fff, Direction=90, Strength=1);
            }
			
			@media screen and (min-width: 768px){
				.custom-logo{
					margin-top: 20px !important;
				}
			}
			
			
			
				
	.pagination{max-width:500px;width:100%;text-align:center;display:inline-block !important;clear:both;margin:20px 0; margin-top: 10px !important;}
	.pagination ul{list-style:none;margin:0;padding-left:0;line-height: 24px;}
	.pagination ul li{float:left;margin-right:10px;margin-bottom:10px}
	.pagination a,.page-numbers{line-height: 24px;display:inline-block;float:left;text-decoration:none;padding:10px 15px;-webkit-transition:all .25s linear;-moz-transition:all .25s linear;transition:all .25s linear;border-radius:3px;min-width:42px; font-family: 'Libre Baskerville',serif;}
	.nav-links .page-numbers{margin-right:7px;margin-bottom:5px}
	.currenttext{float:left;background:#444;border-radius:3px;min-width:42px;display:inline-block;padding:10px 15px;text-shadow:1px 1px 5px #000; color:#FFFFFF;}



	.yout {
		padding-bottom: 10px;
		margin-bottom: 0 !important;
	}

	.yout {
		padding-top: 20px;
	}

	/*.su-row .su-column:first-child {
		margin-left: 0;
	}

	.su-row .su-column-size-1-2 {
		width: 48%;
	}
	.su-row .su-column {
		display: block;
		float: left;
		box-sizing: border-box;
		margin: 0 0 0 4%;
	}

	.su-row::after {
		display: table;
		clear: both;
		content: '';
	}
	*/
	
	
	@media screen and (min-width: 768px){
		.single .container.posrcont{
			border: 0px;
			background: transparent;
		}
		.posrcont .col-lg-9 {
			padding-left: 0px;
		}
		
		.archive .posrcont .col-lg-9 {
			padding-left: 10px;
			padding-right: 10px;
			background:#FFFFFF;
			flex: none;
			float: left;
			max-width: 873px;
			margin-right: 7px;
		}
		
		.archive .pt-cv-colsys{
			margin:0px;
		}
		
		.home #service-page .container{
			margin-top:10px;
		}
		
		.archive .container.posrcont{
			margin-top:10px;
			padding-top: 0px !important;
			background: transparent;
			border: 0px;
		}
		
		.sidebar{
			margin-top: 0px!important;
		}
		
		#blog-content article.blog-post:last-child{
			padding:15px;
		}
		
		.sidebar{
			background: #FFFFFF;
			overflow: hidden;
		}
		
		.single .posrcont .col-lg-9 {
			padding-left: 0px;
			flex: none;
			float: left;
			max-width: 873px;
			background:#FFFFFF;
			margin-right: 0px;
			padding-right: 0px;
		}
		
		.single .posrcont .col-lg-3 {
			min-width: 320px !important;
			flex: none;
			float: right;
			margin-left: 7px;
			max-width: 320px;
		}
		
	}
	
	@media (max-width: 768px) {
		.col-md-12 {
			padding-left: 0px;
			padding-right: 0px;
		}
		
		.top_nav{
			padding-left: 18px;
			padding-right: 18px;
		}
	}
	
	
	
		
	.list-games-cont{
		margin-top:20px;
	}
		
	.list-games-cont table{
		margin-top:20px;
	}
		
	.list-games-cont img{
		width:140px;
		border-radius: 22.5%;
	}
		
	.list-games-cont a{
		color: #000000 !important;
		text-decoration: none !important;
	}
	
	.list-games-cont table{
		background-color:transparent;
	}
	.list-games-cont table,
	.list-games-cont table td {
		border: 0px;
	}
	
	.list-games-cont table tr td:first-child{
		width:38%;
	}
		
	@media screen and (max-width: 768px) {
		.list-games-cont table tr td:first-child{
			width:42%;
		}
	}</style> <script type="litespeed/javascript">jQuery('#banner-wrapper .bannerclosebutton').click(function(e){jQuery('#banner-wrapper').hide()});jQuery(document).ready(function(){if(jQuery('.code-block-9').hasClass('code-block')){jQuery('.code-block-9').parent().parent().parent().addClass('addtop180');jQuery('.code-block-9').parent().parent().parent().next().addClass('addtop180')}
